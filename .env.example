# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Public API URL (blank defaults to relative '/api' on Vercel/Next)
NEXT_PUBLIC_API_URL=

# MongoDB Connection String (Replace with your MongoDB Atlas or local URI)
MONGODB_URI=mongodb://localhost:27017/rijanregmi_db

# Standalone backend proxy toggle (optional for local multi-server dev)
USE_STANDALONE_BACKEND=false
BACKEND_URL=http://localhost:5000

# CORS Whitelist (comma separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5000
